# alembic database url
ALEMBIC_DB_URL=postgresql://postgres:postgres@localhost:5432/postgres


### App
# host (default 0.0.0.0)
APP__HOST=0.0.0.0
# port (default 8000)
APP__PORT=8000
# accept connections (default ["*"])
APP__ORIGINS=["*"]
# database connection url
APP__DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
# App work mode
APP__DEV_MODE=True


### Logging
# url otel collector (default None)
LOGGING__OTEL_URL=localhost:4317
# show sqlalchemy logs (default False)
LOGGING__SHOW_SQL=false
